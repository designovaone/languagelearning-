# dependencies
/node_modules
/.pnp
.pnp.*

# builds
/.next/
/out/
/build
/dist

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- PRIVACY: local-only, never published ------------------------------------
# This repo is public. Everything below stays on disk.

# Working memory + session notes (contain real names, family context, credentials talk)
/MEMORY.md
/CLAUDESESSIONS/

# Pipeline inputs and intermediate artifacts. Bulk content, and some filenames
# carry real names. The pipeline *code* is public; the raw data is not.
/seed/
*.csv
# ...but committed test fixtures must survive the blanket rule above.
!tests/fixtures/*.csv

# Local database dumps
/backups/

# Generated audio lives in blob storage, never on disk in the repo — Vercel has
# no writable filesystem and public/ is baked from git. See PLAN.md §5.
/pipeline/out/

# Raw pipeline downloads: large, unmodified, and re-fetchable with
# pipeline/stages/00_fetch_sources.sh. The derived artifacts ARE checked in.
/pipeline/raw/

# Python bytecode
__pycache__/
*.py[cod]
