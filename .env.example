# Copy to .env.local and fill in. Never commit the filled-in version.

# Postgres connection string (Neon)
DATABASE_URL=

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model ids used per tier (see README: tier 2 is live grading, tier 3 is the nightly job)
OPENROUTER_MODEL_GRADING=
OPENROUTER_MODEL_NIGHTLY=

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared secret protecting the nightly cron endpoint
CRON_SECRET=
