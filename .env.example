# Copy to .env.local and fill in. Never commit the filled-in version.
# See PLAN.md §13 for what each of these is for.

# Postgres connection string (Neon, region aws-eu-central-1)
DATABASE_URL=

# Auth. Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Shared secret protecting the /api/cron/* endpoints
CRON_SECRET=

# OpenRouter — https://openrouter.ai/keys
# Pick the models at build time from the current list, not from an old price table.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_GRADING=
OPENROUTER_MODEL_NIGHTLY=

# Web push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Blob storage for generated pronunciation audio
BLOB_READ_WRITE_TOKEN=

# No TTS credentials needed — audio is generated locally at build time (PLAN.md §5).
